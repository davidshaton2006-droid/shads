# Supabase (новый проект, отдельный от других данных)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Ключ шифрования OAuth-токенов перед записью в БД (32 байта, base64). Сгенерировать:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# Яндекс OAuth-приложение (oauth.yandex.ru) — доступы: Директ (API), Метрика
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
YANDEX_REDIRECT_URI=http://localhost:3000/oauth/yandex/callback

# VK Ads (ads.vk.ru) OAuth-приложение
VK_CLIENT_ID=
VK_CLIENT_SECRET=
VK_REDIRECT_URI=http://localhost:3000/oauth/vk/callback

# Владелец системы — единственный, кто подтверждает preflight-действия
OWNER_EMAIL=davidshaton2006@gmail.com

# Telegram-бот для уведомлений (срабатывание стоп-крана, новая pending_action).
# 1) Создать бота через @BotFather в Telegram, получить токен.
# 2) Написать боту любое сообщение (например "старт").
# 3) Открыть в браузере https://api.telegram.org/bot<TOKEN>/getUpdates и взять "chat":{"id": ...}
#    из последнего апдейта — это и есть TELEGRAM_CHAT_ID.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Доступ к дашборду и /api (HTTP Basic). Без пароля пускает только localhost.
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=

PORT=3000

# ---------- Лидген (поиск клиентов, см. src/leadgen/ и раздел README "Лидген") ----------

# 2ГИС Catalog API — бесплатный тестовый ключ: https://dev.2gis.ru
# Без ключа источник "2ГИС" в дашборде вернёт ошибку, источник "Авито" при этом работает без ключа.
TWOGIS_API_KEY=

# Опционально: если задан, черновики сообщений пишет модель (живее и учитывает контекст лида).
# Без ключа используются заготовленные шаблоны с ротацией — тоже рабочий вариант для старта.
ANTHROPIC_API_KEY=
